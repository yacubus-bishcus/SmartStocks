<CompareStocksOutputScreen>:
    stock_label: stock_label_id
    output_label: output_label_id
    
    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(30)
        spacing: dp(30)

        MDTopAppBar:
            title: "Smart Stocks by Jacob E Bickus"
            left_action_items: [["menu", lambda x: app.menu_bar.open_menu(x)]]
            right_action_items: [["account-circle", lambda x: app.menu_bar.callback_right()]]
            elevation: 5
            pos_hint: {"top": 1}

        MDScrollView:
            MDGridLayout:
                id: main_layout
                cols: 1
                padding: dp(10)
                spacing: dp(20)
                size_hint_y: None
                height: self.minimum_height
                pos_hint: {"center_x": 0.5}

                # Title at the top left
                MDLabel:
                    text: "Compare Stocks Results"
                    font_size: "36sp"
                    adaptive_size: True
                    color: "grey"
                    halign: 'left'

                # Stock information centered below the title
                MDLabel:
                    id: stock_label_id
                    text: "Stock Information will be displayed here."
                    font_size: '36sp'
                    halign: 'center'
                    size_hint_y: None
                    height: self.texture_size[1]
                    color: 1, 1, 1, 1

                # Graph layout
                MDBoxLayout:
                    id: graph_layout
                    orientation: 'vertical'
                    size_hint_x: 1
                    size_hint_y: None
                    height: dp(500)
                    pos_hint: {"center_x":0.5}

                # Buttons for zoom, pan, and reset
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(56)
                    padding: dp(10)
                    spacing: dp(10)
                    pos_hint: {"center_x": 0.5}

                    MDRaisedButton:
                        text: "Zoom In"
                        on_press: root.zoom_in()

                    MDRaisedButton:
                        text: "Zoom Out"
                        on_press: root.zoom_out()

                    MDRaisedButton:
                        text: "Pan Left"
                        on_press: root.pan_left()

                    MDRaisedButton:
                        text: "Pan Right"
                        on_press: root.pan_right()

                    MDRaisedButton:
                        text: "Reset"
                        on_press: root.reset_view()

                # Output label below the graph
                MDLabel:
                    id: output_label_id
                    text: "Output will be displayed here."
                    font_size: '24sp'
                    halign: 'center'
                    size_hint_y: None
                    height: self.texture_size[1]
                    color: 0, 0, 0, 1

                # Recommendations table below the output label
                MDBoxLayout:
                    id: table_layout
                    orientation: 'vertical'
                    size_hint_x: 1 
                    size_hint_y: None 
                    height: dp(300)
                    pos_hint: {"center_x":0.5}
                    padding: dp(10)
                    
                # Back button below everything
                MDRaisedButton:
                    id: back_button
                    text: "Back to Compare Stocks"
                    size_hint_y: None
                    height: dp(50)
                    pos_hint: {"center_x": 0.5}
                    on_press: root.back_to_compare(self)


